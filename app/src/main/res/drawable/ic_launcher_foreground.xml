<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The symbol is scaled to the 66dp adaptive-icon safe zone
         (21..87) so no node is clipped by a circle launcher mask. -->
    <!-- Spokes from the hub to the three nodes, drawn first so the
         circles sit on top of them. -->
    <path
        android:pathData="M54,54 L54,35.5 M54,54 L36,68 M54,54 L72,68"
        android:strokeColor="#5FF2F2"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"/>
    <!-- Hub outer ring. -->
    <path
        android:pathData="M43.5,54 a10.5,10.5 0 1,0 21,0 a10.5,10.5 0 1,0 -21,0 Z"
        android:fillColor="#00000000"
        android:strokeColor="#5FF2F2"
        android:strokeWidth="3.5"/>
    <!-- Hub core, glowing white centre fading to cyan. -->
    <path android:pathData="M47.7,54 a6.3,6.3 0 1,0 12.6,0 a6.3,6.3 0 1,0 -12.6,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="7"
                android:startColor="#FFFFFF"
                android:endColor="#22D3EE"/>
        </aapt:attr>
    </path>
    <!-- Three nodes: top, bottom-left, bottom-right. -->
    <path
        android:pathData="M49,30 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z"
        android:fillColor="#8FF7F7"/>
    <path
        android:pathData="M27,71 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z"
        android:fillColor="#8FF7F7"/>
    <path
        android:pathData="M71,71 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z"
        android:fillColor="#8FF7F7"/>
</vector>
